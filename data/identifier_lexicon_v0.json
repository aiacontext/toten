  "padroes": [
    {
      "classe": "norma",
      "camada": "internacional",
      "regex": "\\bABNT\\s+NBR(?:\\s+ISO)?\\s+\\d{2,6}(?::\\d{4})?\\b",
      "exemplos": ["ABNT NBR 12655", "ABNT NBR ISO 9001:2015"]
    },
    {
      "classe": "norma",
      "camada": "internacional",
      "regex": "\\bNBR\\s+\\d{2,6}\\b",
      "exemplos": ["NBR 6118"]
    },
    {
      "classe": "norma",
      "camada": "internacional",
      "regex": "\\bISO\\s+\\d{3,5}(?::\\d{4})?\\b",
      "exemplos": ["ISO 9001", "ISO 9001:2015"]
    },
    {
      "classe": "norma",
      "camada": "internacional",
      "regex": "\\bASME\\s+[A-Z]\\d+(?:\\.\\d+)*\\b",
      "exemplos": ["ASME B31.3"]
    },
    {
      "classe": "norma",
      "camada": "internacional",
      "regex": "\\bAWS\\s+[A-Z]\\d+(?:\\.\\d+)*[A-Z]?\\b",
